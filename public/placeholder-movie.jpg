<!-- This is a placeholder for movie posters when TMDB image is not available -->
<svg width="300" height="450" viewBox="0 0 300 450" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="300" height="450" fill="#f5f5f5"/>
  <rect x="50" y="150" width="200" height="150" rx="8" fill="#e0e0e0"/>
  <circle cx="150" cy="200" r="30" fill="#bdbdbd"/>
  <rect x="100" y="240" width="100" height="10" rx="5" fill="#bdbdbd"/>
  <rect x="75" y="260" width="150" height="8" rx="4" fill="#d0d0d0"/>
  <rect x="90" y="280" width="120" height="8" rx="4" fill="#d0d0d0"/>
  <text x="150" y="350" text-anchor="middle" fill="#9e9e9e" font-family="Arial, sans-serif" font-size="14">Movie Poster</text>
  <text x="150" y="370" text-anchor="middle" fill="#bdbdbd" font-family="Arial, sans-serif" font-size="12">Not Available</text>
</svg>
